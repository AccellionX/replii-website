[Unit]
Description=Replii landing website
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/replii-website/current
Environment=NODE_ENV=production
Environment=PATH=/opt/replii-website/.runtime/node/bin:/usr/bin:/bin
EnvironmentFile=/opt/replii-website/.env
ExecStart=/opt/replii-website/.runtime/node/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 8020
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
